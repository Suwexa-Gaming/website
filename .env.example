# Public address of the site. Used for canonical URLs, the sitemap and sharing tags.
NEXT_PUBLIC_SITE_URL=https://suwexa.vercel.app

# Address shown on the site. Defaults to suwexagaming@gmail.com.
NEXT_PUBLIC_CONTACT_EMAIL=

# The public Google Play URL for Carrom Crest. Set this only once the listing is live.
# Setting it shows the download button and marks the game as available.
# NEXT_PUBLIC_CARROM_CREST_PLAY_URL=https://play.google.com/store/apps/details?id=dev.carromcrest.game

# Optional. With all three set, the contact form sends through Resend (resend.com).
# Without them, the form opens the visitor's own email app instead. Server-side only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
